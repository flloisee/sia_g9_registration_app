# App
PORT=4000

# Public origin used in email links and Origin checks — scheme + host only, no
# trailing slash (e.g. https://events.example.com). Required for any non-localhost
# host; falls back to the request host only on localhost.
# Sharing through a tunnel? Set it to that exact URL, e.g.
# https://event-registration-sia.loca.lt (localtunnel, must match TUNNEL_SUBDOMAIN)
# or your ngrok dev domain from https://dashboard.ngrok.com/domains, and restart.
APP_ORIGIN=

# Reverse proxy / tunnel: a hop count (1) or a comma-separated subnet list.
# Set to 1 behind localtunnel, ngrok or any TLS-terminating proxy so rate limits
# see real client IPs instead of the proxy's.
TRUST_PROXY=

# Force the session cookie's Secure flag when TLS terminates before Express.
COOKIE_SECURE=false

# Telemetry logs go to docs/logs/latest.log and rotate to YYYY-MM-DD-logs.log daily.
# Archived days older than this are deleted on startup and after each rotation.
LOG_RETENTION_DAYS=14

# Owner account for /dev/admin — applied by `npm run db:migrate`.
# Required: a unique passphrase of at least 12 characters. Re-run the migration to change it.
ADMIN_NAME=Event Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sia_event_registration

# Email (Gmail app password). Enable 2-Step Verification, create an app
# password at https://myaccount.google.com/apppasswords, then set SMTP_USER to
# the full Gmail address and SMTP_PASS to the 16-character app password.
# MAIL_FROM must be that address or a verified Gmail alias.
# Leave SMTP_USER empty to use a local Ethereal test inbox instead.
SMTP_USER=
SMTP_PASS=
# Only override these to use another SMTP provider.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
MAIL_FROM="SIA G9 <your.address@gmail.com>"

# Only used to name the first event created by the migration.
EVENT_NAME=SIA G9

# localtunnel subdomain (https://<TUNNEL_SUBDOMAIN>.loca.lt). Falls back to
# event-registration-sia when unset.
TUNNEL_SUBDOMAIN=event-registration-sia

# TRUE: always use TUNNEL_SUBDOMAIN (errors if taken). FALSE: accept the random
# subdomain localtunnel assigns — then copy that URL into APP_ORIGIN and restart.
TUNNEL_USE_SUBDOMAIN=TRUE

# Tunnel provider used by `npm run share`: localtunnel or ngrok.
# ngrok is the more reliable option. `npm run share:ngrok` forces ngrok for one
# run without editing this file; `npm run share` uses whatever is set here.
TUNNEL_PROVIDER=ngrok
