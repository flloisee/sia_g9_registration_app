# App
PORT=4000

# Default admin account for /dev/admin — applied by `npm run db:migrate`.
# Edit here and re-run the migration to change the password (it revokes sessions).
ADMIN_NAME=Event Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sia_event_registration

# Email (SMTP). Leave SMTP_HOST empty to use a local Ethereal test inbox
# whose preview link is printed to the console and shown on the ticket page.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="SIA G9 <tickets@yourdomain.com>"

# Only used to name the first event created by the migration.
EVENT_NAME=SIA G9

# localtunnel subdomain (https://<TUNNEL_SUBDOMAIN>.loca.lt). Falls back to
# event-registration-sia when unset.
TUNNEL_SUBDOMAIN=event-registration-sia

# TRUE: always use TUNNEL_SUBDOMAIN (errors if taken). FALSE: accept the random
# subdomain localtunnel assigns.
TUNNEL_USE_SUBDOMAIN=TRUE
